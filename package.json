{
  "name": "jsubagent",
  "version": "0.1.1",
  "private": false,
  "description": "Durable Pi subagents with isolated context, event-driven waits, and bounded messaging",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "src/",
    "agents/",
    "config.example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "check:flow": "node scripts/check-flow.mjs",
    "check:subagents": "node scripts/check-subagents.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:install": "node scripts/check-install.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "license": "MIT",
  "author": "newoostory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newoostory/Jsubagent.git"
  },
  "homepage": "https://github.com/newoostory/Jsubagent#readme",
  "bugs": {
    "url": "https://github.com/newoostory/Jsubagent/issues"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.3.7"
  }
}
